{
  "class": "ssrf",
  "description": "URLs a server-side fetcher must refuse, and public URLs it must still allow. Feed each input to your URL validator or fetch wrapper.",
  "convention": "Rejected = the function throws, rejects, or returns false/null/undefined. Accepted = anything else.",
  "oracle": "Every attack must be rejected. Every legit input must be accepted. Entries with needs_dns require working DNS; entries with needs_network also need outbound internet.",
  "attacks": [
    { "input": "http://127.0.0.1/", "why": "loopback" },
    { "input": "http://localhost/", "why": "loopback by name" },
    { "input": "http://LOCALHOST./", "why": "case + trailing dot defeat string compares against 'localhost'" },
    { "input": "http://127.1/", "why": "short IPv4 form; WHATWG URL normalizes to 127.0.0.1" },
    { "input": "http://0/", "why": "0.0.0.0 reaches local services on Linux and macOS" },
    { "input": "http://0.0.0.0/", "why": "unspecified address, connects to localhost" },
    { "input": "http://2130706433/", "why": "decimal integer form of 127.0.0.1" },
    { "input": "http://0x7f000001/", "why": "hex integer form of 127.0.0.1" },
    { "input": "http://0177.0.0.1/", "why": "octal first octet" },
    { "input": "http://0x7f.1/", "why": "mixed hex + short form" },
    { "input": "http://127.000.000.001/", "why": "zero-padded octets" },
    { "input": "http://１２７.０.０.１/", "why": "fullwidth digits; IDNA mapping turns them into 127.0.0.1" },
    { "input": "http://127。0。0。1/", "why": "ideographic full stops act as dots after IDNA mapping" },
    { "input": "http://[::1]/", "why": "IPv6 loopback" },
    { "input": "http://[::]/", "why": "IPv6 unspecified" },
    { "input": "http://[::ffff:127.0.0.1]/", "why": "IPv4-mapped IPv6 loopback; slips past IPv4-only blocklists" },
    { "input": "http://[0:0:0:0:0:ffff:7f00:1]/", "why": "IPv4-mapped loopback, fully expanded hex" },
    { "input": "http://[::ffff:a9fe:a9fe]/", "why": "IPv4-mapped 169.254.169.254 (cloud metadata)" },
    { "input": "http://[64:ff9b::7f00:1]/", "why": "NAT64 prefix embedding 127.0.0.1; Python is_global says True" },
    { "input": "http://[2002:7f00:1::]/", "why": "6to4 prefix embedding 127.0.0.1" },
    { "input": "http://169.254.169.254/latest/meta-data/", "why": "AWS/GCP/Azure/OCI metadata endpoint" },
    { "input": "http://[fd00:ec2::254]/latest/meta-data/", "why": "AWS IMDS over IPv6 (unique local address)" },
    { "input": "http://100.100.100.200/latest/meta-data/", "why": "Alibaba Cloud metadata (CGNAT range)" },
    { "input": "http://metadata.google.internal/computeMetadata/v1/", "why": "GCP metadata hostname" },
    { "input": "http://10.0.0.1/", "why": "RFC 1918 private" },
    { "input": "http://172.16.0.1/", "why": "RFC 1918 private" },
    { "input": "http://192.168.1.1/", "why": "RFC 1918 private (routers, admin panels)" },
    { "input": "http://[fe80::1]/", "why": "IPv6 link-local" },
    { "input": "http://[fc00::1]/", "why": "IPv6 unique local" },
    { "input": "http://user@127.0.0.1/", "why": "userinfo before a blocked host" },
    { "input": "http://example.com@127.0.0.1/", "why": "allowlisted-looking name in userinfo; real host is 127.0.0.1" },
    { "input": "http://127.0.0.1:6379/", "why": "internal service port (Redis)" },
    { "input": "file:///etc/passwd", "why": "non-HTTP scheme reads local files in some clients" },
    { "input": "gopher://127.0.0.1:6379/_INFO", "why": "gopher smuggles raw bytes to TCP services in curl-based clients" },
    { "input": "ftp://127.0.0.1/", "why": "non-HTTP scheme" },
    { "input": "dict://127.0.0.1:11211/stats", "why": "dict scheme talks to memcached in curl-based clients" },
    { "input": "http://localtest.me/", "why": "public DNS name that resolves to 127.0.0.1 (rebinding-style)", "needs_dns": true },
    { "input": "http://127.0.0.1.nip.io/", "why": "wildcard DNS that resolves to the embedded IP", "needs_dns": true },
    { "input": "http://169.254.169.254.nip.io/", "why": "wildcard DNS to the metadata IP", "needs_dns": true }
  ],
  "legit": [
    { "input": "https://1.1.1.1/", "why": "public IPv4 literal" },
    { "input": "https://[2606:4700:4700::1111]/", "why": "public IPv6 literal" },
    { "input": "https://example.com/", "why": "ordinary public hostname", "needs_dns": true },
    { "input": "https://example.org/path?q=1#frag", "why": "path, query and fragment", "needs_dns": true },
    { "input": "http://example.net/", "why": "plain HTTP on port 80", "needs_dns": true }
  ]
}
