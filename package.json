{
  "name": "bypass-proof-security-dev",
  "private": true,
  "description": "Test harness for the bypass-proof-security skill. Not part of the installed skill.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=120000 'tests/bypass-proof-security/node/*.test.mjs' && node tests/bypass-proof-security/scan/check-fixtures.mjs tests/bypass-proof-security/scan/fixtures && node tests/bypass-proof-security/check-links.mjs && node tests/bypass-proof-security/check-frontmatter.mjs",
    "test:python": "uv run --with pytest --with httpx pytest tests/bypass-proof-security/python -q"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "jose": "^6.2.14",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "undici": "^7.30.1",
    "yaml": "^2.9.1"
  }
}
